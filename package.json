    },
    "homepage": "https://github.com/erikvanek/erikvanek.github.io#readme",
    "dependencies": {
        "@11ty/eleventy": "^3.0.0",
        "@11ty/eleventy-plugin-webc": "^0.11.2",
        "@anthropic-ai/sdk": "^0.65.0",
        "dotenv": "^17.2.3",
        "markdown-it-attrs": "^4.3.1",
        "markdown-it-link-attributes": "^4.0.1"
    },
    "devDependencies": {
        "@slidev/cli": "^52.19.1",
