{
    "name": "erikvanek.github.io",
    "version": "1.0.0",
    "description": "This is generated output from [source repository](https://github.com/erikvanek/erikvanek.com). Never make changes in this one, rather generate new version from aformentioned repo.",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "build": "eleventy",
        "slides": "slidev pages/presentations/slidev/slides.md",
        "build:slides": "node scripts/build-slidev-decks.mjs",
        "start": "eleventy --serve",
        "debug:node": "node --trace-warnings node_modules/.bin/eleventy --serve",
        "debug:eleventy": "DEBUG=Eleventy* node --trace-warnings node_modules/.bin/eleventy --serve",
        "format": "prettier **/*.md",
        "format:fix": "prettier --write '**/*.md'",
        "test": "vitest run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/erikvanek/erikvanek.github.io.git"
    },
